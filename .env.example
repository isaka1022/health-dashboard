# Database — local SQLite path is already hardcoded in prisma/schema.prisma.
# Override here only if you want a different location.
DATABASE_URL="file:./prisma/dev.db"

# NextAuth — required even if you do not use Google OAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-any-random-string"

# Google OAuth (optional — only needed for Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
